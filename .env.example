DB_PASSWORD=your_postgres_password
JWT_SECRET=your_jwt_secret_key
AI_API_KEY=your_gemini_api_key

# The variables below are only needed for cloud deployment (Render + managed Postgres/Kafka).
# Leave them unset for local Docker Compose — sensible defaults are used instead.
# DB_URL=jdbc:postgresql://your-host:5432/your-db
# DB_USERNAME=your_db_username
# KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:port
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="user" password="pass";
# KAFKA_TRUSTSTORE_LOCATION=classpath:kafka/kafka-truststore.jks
# KAFKA_TRUSTSTORE_PASSWORD=changeit